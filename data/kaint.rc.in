// Recursos del ejecutable de Windows: icono y datos de la versión.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/data/kaint.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "SSSerch"
            VALUE "FileDescription", "Kaint"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "kaint"
            VALUE "LegalCopyright", "Copyright (C) 2026 SSSerch (aka Y2Kerchy). GPL-3.0."
            VALUE "OriginalFilename", "kaint.exe"
            VALUE "ProductName", "Kaint"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
