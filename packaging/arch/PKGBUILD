# Paquete de Arch Linux de Kaint a partir de este código (./build.sh --pkg)
_src="${KAINT_SOURCE_DIR:-$(realpath "$startdir/../..")}"

pkgname=kaint
pkgver=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$_src/version.json")
pkgrel=1
pkgdesc="Paint.NET-style image editor built with C++20 and Qt 6"
arch=('x86_64' 'aarch64')
url="https://github.com/ssserch/Kaint"
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-svg' 'qt6-multimedia' 'zlib' 'hicolor-icon-theme' 'kwindowsystem' 'libdatachannel'
         'libwebp' 'libavif' 'libjxl' 'libheif')
makedepends=('cmake' 'ninja' 'qt6-tools' 'dotnet-sdk')
options=('!debug')
optdepends=('qt6-wayland: Wayland'
            'breeze-icons: KDE icons'
            'qt6-imageformats: WebP, TIFF and more formats'
            'kimageformats: AVIF, JPEG XL, PSD and more formats'
            'qt6-translations: translated Qt dialogs'
            'ffmpeg: audio (MP3, OGG, FLAC...) and video export (MP4, WebM) in the GIF editor'
            'dotnet-runtime: Paint.NET 3.x-5.x plugins (the .NET plugin system, the default)'
            'mono: Paint.NET plugins (with OpenD2D; fallback of the .NET plugin system)'
            'wine: Paint.NET plugins through Wine'
            'libgdiplus: Paint.NET plugins that use System.Drawing')

build() {
    # OpenD2D (Direct2D de código abierto para los complementos de Paint.NET): build.sh elige la
    # versión (la última, una publicada o la copia de 2dlocal/); se compila con cargo si está.
    cmake -S "$_src" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF \
        -DKAINT_OPEND2D="${KAINT_OPEND2D:-AUTO}" -DKAINT_OPEND2D_REF="${KAINT_OPEND2D_REF:-latest}" \
        -DKAINT_OPEND2D_SOURCE="${KAINT_OPEND2D_SOURCE:-}"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
