<?xml version="1.0" encoding="utf-8"?>
<!-- Kaint: una excepción sin capturar en un hilo de un complemento (2D Image Filter copia el
     resultado al portapapeles en un hilo suyo, con partes de Paint.NET que la capa de
     compatibilidad no tiene) no debe cerrar el proceso auxiliar: se ignora, como en .NET 1.1, y
     el efecto sigue funcionando. -->
<configuration>
  <runtime>
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
